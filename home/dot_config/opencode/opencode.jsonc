// ~/.config/opencode/opencode.jsonc
//
// Managed by chezmoi.
//
// PROVIDER INDEPENDENCE BY DESIGN
// This file deliberately does NOT set `model`, `default_agent`, `providers`
// or any credentials. The provider, the model and the credentials are a
// personal, machine local decision made through `opencode auth login`.
//
// Only properties documented for the installed OpenCode version are used.
// Verified against OpenCode v2.x documentation.
// Reference: https://opencode.ai/v2/docs/config
//
// SECURITY
// Never write an API key here. If a value ever must be injected, reference an
// environment variable instead of the literal, for example:
//   "mcp": { "servers": { "example": { "headers": { "Authorization": "{env:TOKEN}" } } } }

{
  "$schema": "https://opencode.ai/config.json",

  // Ask before running an update check; never install anything automatically.
  "update": "notify",

  // Filesystem snapshots give undo/revert without touching Git history.
  "snapshots": true,

  // Ignore build output and local state so the watcher stays quiet and fast.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      ".git/**",
      "*.log",
      "**/*.env",
      "**/*.pem",
      "**/*.key"
    ]
  },

  // Cap tool output so a runaway log cannot flood the context window.
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },

  // Conservative global permissions. Broad rules first, exceptions after,
  // because the LAST matching rule wins.
  //
  // Rules here apply before the per-agent rules in agents/*.md, so an agent
  // can refine them but cannot silently widen them.
  "permissions": [
    // 1. Deny the irreversible operations outright.
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- .", "effect": "deny" },
    { "action": "shell", "resource": "dd if=*", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "curl * | sh", "effect": "ask" },
    { "action": "shell", "resource": "wget * | sh", "effect": "ask" },

    // 2. Ask before anything that leaves the machine or rewrites history.
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "ask" },
    { "action": "shell", "resource": "docker push*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "terraform apply*", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "ask" },
    { "action": "shell", "resource": "aws * delete*", "effect": "ask" },
    { "action": "shell", "resource": "az * delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh release*", "effect": "ask" },
    { "action": "shell", "resource": "pip install*", "effect": "ask" },

    // 3. Reading real environment files is always explicit.
    { "action": "read", "resource": "**/.env", "effect": "ask" },
    { "action": "read", "resource": "**/.env.*", "effect": "ask" },
    { "action": "read", "resource": "**/*.pem", "effect": "ask" },
    { "action": "read", "resource": "**/*.key", "effect": "ask" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },

    // 4. Only the small set of read-only commands that run on every turn.
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "tree*", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },

    // 5. Skills are loadable, but nothing is hidden from the model by default.
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],

  // Project level instructions always load, in addition to AGENTS.md files.
  // The global AGENTS.md lives next to this config.
  "instructions": ["AGENTS.md"],

  // No formatter is forced globally: each project decides how its files are
  // formatted. Enabling this would rewrite files behind the user's back.
  "formatter": false,

  // Default parent directory for worktrees, so parallel changes stay isolated.
  "worktree": {
    "directory": ".worktrees"
  }
}
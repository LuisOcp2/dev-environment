# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Two trailing spaces are meaningful (hard line break) in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.py]
indent_size = 4

[*.{go,rs}]
indent_style = tab

[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

[*.{env,txt,md}]
# Keep dotfile targets free of surprises when chezmoi rewrites them.
insert_final_newline = true
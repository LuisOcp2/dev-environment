# ---------------------------------------------------------------------------
# cloud.env - Docker, GitHub CLI and optional infrastructure tooling.
#
# Heavy cloud CLIs are intentionally NOT installed here:
#   kubectl   -> mise registry plugin   (https://mise.jdx.dev)
#   terraform -> mise registry plugin
#   awscli    -> pipx / uv tool install
#   azcli     -> snap or Microsoft apt repository
#
# See docs/PROFILES.md for the exact commands to enable them.
# ---------------------------------------------------------------------------

PROFILE_DESCRIPTION="cloud - Docker, GitHub CLI and optional IaC tooling"

PROFILE_INHERITS="minimal"
PACKAGE_SETS="base cloud"
MISE_TOOLS="terraform kubectl"
PROFILE_FLAGS="docker cloud"
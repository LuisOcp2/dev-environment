# ---------------------------------------------------------------------------
# minimal.env - smallest useful development machine.
#
# Git, shell tooling, chezmoi and mise only. No Docker, no editors, no cloud.
# Every other profile inherits from this one.
# ---------------------------------------------------------------------------

PROFILE_DESCRIPTION="minimal - shell, git, search tooling, chezmoi and mise"

PROFILE_INHERITS=""
PACKAGE_SETS="base"
MISE_TOOLS="shfmt"
PROFILE_FLAGS=""
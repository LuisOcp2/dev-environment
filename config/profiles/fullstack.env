# ---------------------------------------------------------------------------
# fullstack.env - frontend + backend + Docker + database clients.
#
# This is the default profile. Docker is enabled through the "docker" flag,
# which scripts/install-docker.sh checks; --skip-docker bypasses it.
# ---------------------------------------------------------------------------

PROFILE_DESCRIPTION="fullstack - frontend, backend, Docker and database clients"

PROFILE_INHERITS="frontend backend"
PACKAGE_SETS="fullstack"
MISE_TOOLS="node pnpm python uv java"
PROFILE_FLAGS="docker vscode"
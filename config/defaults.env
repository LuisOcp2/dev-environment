# ---------------------------------------------------------------------------
# defaults.env - global defaults for the development environment.
#
# This file is sourced first by every entry point. It contains NO secrets and
# NO machine specific paths. Override any value with a real environment
# variable before running the bootstrap, or edit this file in your fork.
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
# Public identity only. Never place private data, tokens or keys here.
DEV_ENV_OWNER="Luis Miguel Ocampo Guerrero"
DEV_ENV_GITHUB_USER="LuisOcp2"
DEV_ENV_REPOSITORY="https://github.com/LuisOcp2/dev-environment.git"

# --- Defaults --------------------------------------------------------------
DEFAULT_PROFILE="fullstack"
PROFILE_DIR="config/profiles"

# --- Behaviour -------------------------------------------------------------
# Ask before changing anything that touches the home directory.
ASSUME_INTERACTIVE_APPLY="true"
# Offer to switch the login shell to zsh during bootstrap. The switch only
# happens after an explicit confirmation (see set_shell_default in
# scripts/lib/common.sh).
OFFER_ZSH_DEFAULT="true"
# Report every executable with its version at the end of the bootstrap.
SHOW_SUMMARY="true"

# --- Tools installed outside the system package manager --------------------
# Each installer checks whether the tool is already present and exits early,
# so re-running the bootstrap never reinstalls anything.
CHEZMOI_INSTALL_URL="https://get.chezmoi.io"
MISE_INSTALL_URL="https://mise.run"
DOCKER_INSTALL_URL="https://get.docker.com"

# Minimum acceptable versions. Reported by scripts/verify.sh; they do not
# trigger automatic upgrades.
MIN_GIT_VERSION="2.34"
MIN_CHEZMOI_VERSION="2.40"
MIN_MISE_VERSION="0.5"
MIN_DOCKER_VERSION="24.0"

# --- mise ------------------------------------------------------------------
# Global tool versions live in home/dot_config/mise/config.toml, managed by
# chezmoi. MISE_GLOBAL_CONFIG lets a user point at an unmanaged copy instead.
MISE_GLOBAL_CONFIG="${MISE_GLOBAL_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/mise/config.toml}"

# --- Editors ---------------------------------------------------------------
# VS Code extension recommendations live in config/vscode-extensions.txt so
# they can be maintained independently from this file.

# --- Behaviour of optional installers --------------------------------------
# Heavy or opinionated installers stay opt-in.
INSTALL_DOCKER_BY_DEFAULT="false"
INSTALL_AZURE_CLI="false"
INSTALL_AWS_CLI="false"
# --no-install-recommends keeps a minimal profile small. Set to "true" to let
# apt install recommended packages as well.
APT_INSTALL_RECOMMENDS="false"